# First Person Example scene descriptor (TEXT, not a binary scene). TemplateManager bakes it into the binary
# Assets/Scenes/Main.rscene when a project is created: binary scenes/prefabs only resolve once the new
# project's AssetDatabase exists, so author scenes in the editor and keep this file as the recipe.
# Format: entity <Name> | key=value | ...   (asset paths are relative to Assets/)
# Keys: mesh, pos, rot, scale, texture, box=sx,sy,sz[,trigger], sphere=r[,trigger], capsule=r,h,
#       body=static|kinematic|dynamic, script=<file>, camera, light, parent=<EntityName>, prop.<field>=<value>
#       prefab=<file>  instantiates a prefab (with its children) as-is; pos/rot/scale/script/prop apply to its root,
#                      and <Name> renames the root.
entity Ground       | mesh=Meshes/Plane.obj | pos=0,0,0 | scale=3,1,3 | texture=Textures/Checker.png | box=10,0.2,10 | body=static
entity Player       | prefab=Prefabs/FPSController.prefab.bin | pos=0,1.5,6 | script=Scripts/PlayerCombatScript.java
entity GameManager  | pos=0,0,0 | script=Scripts/GameManagerScript.java
entity Collectible1 | mesh=Meshes/Cube.obj | pos=4,1,0     | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible2 | mesh=Meshes/Cube.obj | pos=-4,1,0    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible3 | mesh=Meshes/Cube.obj | pos=0,1,-5    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible4 | mesh=Meshes/Cube.obj | pos=8,1,-8    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=5
entity Collectible5 | mesh=Meshes/Cube.obj | pos=-8,1,-8   | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=5
entity Platform     | mesh=Meshes/Cube.obj | pos=0,0.75,-10 | scale=3,1.5,3 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity Collectible6 | mesh=Meshes/Cube.obj | pos=0,2.5,-10 | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=10
entity Sun          | pos=0,8,0 | rot=50,30,0 | light
