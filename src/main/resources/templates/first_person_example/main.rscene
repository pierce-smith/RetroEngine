# First Person Example scene descriptor (TEXT, not a binary scene). TemplateManager bakes it into the binary
# Assets/Scenes/Main.rscene when a project is created: binary scenes/prefabs only resolve once the new
# project's AssetDatabase exists, so author scenes in the editor and keep this file as the recipe.
# Format: entity <Name> | key=value | ...   (asset paths are relative to Assets/)
# Keys: mesh, pos, rot, scale, texture, box=sx,sy,sz[,trigger], sphere=r[,trigger], capsule=r,h[,offsetY],
#       body=static|kinematic|dynamic, script=<file>, camera, light, particles=fire|sparks, parent=<EntityName>,
#       navagent=speed,stoppingDistance,baseOffset (NavMeshAgent; a .navmesh is baked for scenes that have agents),
#       spline=x,y,z;x,y,z;... (Catmull-Rom knots relative to pos),
#       follower=<splineEntity>,speed,clamp|loop|ping_pong,alignToTangent,autoPlay (SplineFollower),
#       prop.<field>=<value>
#       prefab=<file>  instantiates a prefab (with its children) as-is; pos/rot/scale/script/prop apply to its root,
#                      and <Name> renames the root.
entity Ground       | mesh=Meshes/Plane.obj | pos=0,0,0 | scale=3,1,3 | texture=Textures/Checker.png | box=10,0.2,10 | body=static
entity Player       | prefab=Prefabs/FPSController.rprefab | pos=0,1.5,6 | script=Scripts/PlayerCombatScript.java
entity GameManager  | pos=0,0,0 | script=Scripts/GameManagerScript.java
entity Collectible1 | mesh=Meshes/Cube.obj | pos=4,1,0     | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible2 | mesh=Meshes/Cube.obj | pos=-4,1,0    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible3 | mesh=Meshes/Cube.obj | pos=0,1,-5    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java
entity Collectible4 | mesh=Meshes/Cube.obj | pos=8,1,-8    | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=5
entity Collectible5 | mesh=Meshes/Cube.obj | pos=-8,1,-8   | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=5
entity Platform     | mesh=Meshes/Cube.obj | pos=0,0.75,-10 | scale=3,1.5,3 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity Collectible6 | mesh=Meshes/Cube.obj | pos=0,2.5,-10 | scale=0.4,0.4,0.4 | sphere=1.2,trigger | body=kinematic | script=Scripts/CollectibleScript.java | prop.points=10
entity Sun          | pos=0,8,0 | rot=50,30,0 | light
# Torches flanking the platform: ParticleSystem flames animated by TorchFlameScript (press F nearby to snuff / relight)
entity TorchPostL   | mesh=Meshes/Cube.obj | pos=-2.2,0.6,-7.6 | scale=0.12,1.2,0.12 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity TorchFlameL  | pos=-2.2,1.25,-7.6 | particles=fire | script=Scripts/TorchFlameScript.java
entity TorchPostR   | mesh=Meshes/Cube.obj | pos=2.2,0.6,-7.6 | scale=0.12,1.2,0.12 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity TorchFlameR  | pos=2.2,1.25,-7.6 | particles=fire | script=Scripts/TorchFlameScript.java
# Steps up the platform's +X side (0.3 m rises, within the NavMesh step height) so the chaser can follow you up
entity Step1        | mesh=Meshes/Cube.obj | pos=3.6,0.2,-10  | scale=0.6,0.4,2 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity Step2        | mesh=Meshes/Cube.obj | pos=3.0,0.35,-10 | scale=0.6,0.7,2 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity Step3        | mesh=Meshes/Cube.obj | pos=2.4,0.5,-10  | scale=0.6,1.0,2 | texture=Textures/Checker.png | box=1,1,1 | body=static
entity Step4        | mesh=Meshes/Cube.obj | pos=1.8,0.65,-10 | scale=0.6,1.3,2 | texture=Textures/Checker.png | box=1,1,1 | body=static
# NavMesh AI: chases the player over the baked NavMesh and deals damage in reach (GameManager tracks health)
entity AI Chaser    | mesh=Meshes/Cube.obj | pos=8,0.5,4 | scale=0.8,0.8,0.8 | box=1,1,1 | navagent=3.0,1.2,0.4 | script=Scripts/ChaserScript.java
# Opening flyover: CutsceneTrack holds the spline; CutsceneCamera rides it (SplineFollower) and OpeningCutsceneScript
# suspends player input, then eases into the player's camera and hands control back (Space / Enter skips)
entity CutsceneTrack  | pos=0,0,0 | spline=16,9,16;14,7,-2;6,6,-16;-8,5,-14;-13,4,-2;-7,3.2,9;0,2.4,10
entity CutsceneCamera | pos=16,9,16 | camera=60 | follower=CutsceneTrack,8,clamp,false,true | script=Scripts/OpeningCutsceneScript.java
