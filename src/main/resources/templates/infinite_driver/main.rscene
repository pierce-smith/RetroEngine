# Infinite Driver scene descriptor (TEXT recipe, baked into Assets/Scenes/Main.rscene by TemplateManager).
# Format: entity <Name> | key=value | ...   (asset paths relative to Assets/). See TemplateManager.parseScene for keys;
# extra keys used here: camera=<fov>, audio=<file>[,loop][,manual][,vol:<v>], vehicle, uitext=<ax>,<ay>,<fontSize>,
#   uipanel=<ax>,<ay>,<w>,<h>,<r>,<g>,<b>,<alpha>, uibar=<ax>,<ay>,<w>,<h>,<r>,<g>,<b>  (UI anchors: 0,0 bottom-left, 1,1 top-right).
# The car is moved by the built-in VehicleController (CarDriverScript feeds it speed/steering). HighwayGameScript keeps
# the car at the origin (floating origin: the world shifts by the car's forward travel each frame), recycles the RoadSeg* roots
# (each with its children) and re-uses the Obstacle* pool, so the highway is endless and procedurally varied.

entity GameManager | pos=0,0,0 | script=Scripts/HighwayGameScript.java
entity Sun         | pos=0,30,0 | rot=55,35,0 | light

# Player car (GGBot PSX Car 03). Model nose points +Z, so it is yawed 180 to face down the road (-Z).
entity Car         | mesh=Meshes/Car3.obj | pos=0,0,0 | rot=0,180,0 | scale=0.7,0.7,0.7 | texture=Textures/car3_red.png | vehicle | audio=Audio/Car2_Engine_Loop.ogg,loop,vol:0.6 | script=Scripts/CarDriverScript.java
entity SFX_StartUp | pos=0,0.5,0 | parent=Car | audio=Audio/Car2_Engine_Start_Up.ogg,manual,vol:0.9
entity SFX_Horn    | pos=0,0.5,0 | parent=Car | audio=Audio/Car_Horn.ogg,manual
entity SFX_Boost   | pos=0,0.5,0 | parent=Car | audio=Audio/Car_Acceleration.ogg,manual,vol:0.8
entity SFX_Crash   | pos=0,0.5,0 | parent=Car | audio=Audio/Car_Door_Close.ogg,manual,vol:1.6

entity Main Camera | pos=0,3.4,8 | rot=12,0,0 | camera=65
entity Music          | parent=Main Camera | audio=Audio/Music_Loop.ogg,loop,manual,vol:0.5
entity HUD TopBar     | parent=Main Camera | uipanel=0.5,0.92,520,96,0.05,0.05,0.08,0.6
entity HUD Score      | parent=Main Camera | uitext=0.5,0.94,40
entity HUD Best       | parent=Main Camera | uitext=0.5,0.895,20
entity HUD SpeedPanel | parent=Main Camera | uipanel=0.86,0.08,300,70,0.05,0.05,0.08,0.6
entity HUD Speed      | parent=Main Camera | uitext=0.86,0.1,30
entity HUD SpeedBar   | parent=Main Camera | uibar=0.86,0.055,260,12,1.0,0.55,0.1
entity HUD MsgPanel   | parent=Main Camera | uipanel=0.5,0.5,760,190,0.05,0.05,0.08,0.7
entity HUD Message    | parent=Main Camera | uitext=0.5,0.53,48
entity HUD SubMessage | parent=Main Camera | uitext=0.5,0.46,22
entity HUD Controls   | parent=Main Camera | uitext=0.17,0.05,18

